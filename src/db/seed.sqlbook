-- ---------------------------------------------------------------------
-- 8. RESINCRONIZACION DE SECUENCIAS (obligatorio tras cargar IDs explicitos)
-- ---------------------------------------------------------------------

DO $$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY[
    'roles',
    'calidad_usuario',
    'contraparte',
    'tipo_proceso',
    'subtipo_proceso',
    'tipo_pretension',
    'instancias',
    'tipo_actuacion',
    'tipo_documento',
    'tipo_notificacion',
    'medio_notificacion',
    'estado_proceso',
    'estado_etapa',
    'estado_tarea',
    'prioridad',
    'tipo_proc_subtipo_proc_tipo_pre',
    'etapas_procesales',
    'users',
    'tareas_plantilla',
    'expediente',
    'etiqueta',
    'iter_procesal_plantilla'
  ] LOOP
    EXECUTE format(
      'SELECT setval(pg_get_serial_sequence(''koop.%1$I'',''id''),
               COALESCE((SELECT MAX(id) FROM koop.%1$I), 1), true)', t);
  END LOOP;
END $$;

COMMIT;

