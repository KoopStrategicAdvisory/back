-- =====================================================================
-- KOOP · Sistema de Gestión Procesal — Esquema PostgreSQL
-- Generado desde 'Base de datos KoopVF.xlsx' (hojas Modelo Relacional / _modelo_back)
-- Destino sugerido: C:\Workspace\koop\back\src\db\schema.sql
-- =====================================================================
-- Convenciones:
--   · identificadores en minuscula_con_guiones_bajos
--   · PK: bigint GENERATED BY DEFAULT AS IDENTITY (conserva los IDs del Excel)
--   · soft-delete: columna active boolean NOT NULL DEFAULT true
--   · auditoria: created_at / updated_at timestamptz + trigger set_updated_at()
--   · FKs de catalogo: ON DELETE RESTRICT · FKs de detalle: ON DELETE CASCADE
-- =====================================================================

BEGIN;

CREATE SCHEMA IF NOT EXISTS koop;
SET search_path TO koop, public;

-- ---------------------------------------------------------------------
-- 1. CATALOGOS
-- ---------------------------------------------------------------------

CREATE TABLE roles (
  id           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre       varchar(60)  NOT NULL UNIQUE,
  descripcion  text,
  active       boolean      NOT NULL DEFAULT true
);

CREATE TABLE calidad_usuario (
  id       bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  calidad  varchar(120) NOT NULL UNIQUE,
  active   boolean      NOT NULL DEFAULT true
);

CREATE TABLE contraparte (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(255) NOT NULL,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE clientes (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre            varchar(255) NOT NULL,
  tipo_persona      varchar(20)  CHECK (tipo_persona IN ('NATURAL','JURIDICA')),
  tipo_documento    varchar(10)  CHECK (tipo_documento IN ('CC','CE','PA','NIT','TI','RC')),
  numero_documento  varchar(30),
  email             varchar(150),
  telefono          varchar(40),
  active            boolean      NOT NULL DEFAULT true,
  CONSTRAINT uq_clientes_documento UNIQUE (tipo_documento, numero_documento)
);

CREATE TABLE tipo_proceso (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(120) NOT NULL UNIQUE,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE subtipo_proceso (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(255) NOT NULL,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE tipo_pretension (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(500) NOT NULL,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE instancias (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(80) NOT NULL UNIQUE,
  active  boolean     NOT NULL DEFAULT true
);

CREATE TABLE tipo_actuacion (
  id           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre       varchar(150) NOT NULL UNIQUE,
  descripcion  text,
  active       boolean      NOT NULL DEFAULT true
);

-- OJO: cataloga documentos del expediente (poder, demanda...), NO el documento de identidad
CREATE TABLE tipo_documento (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(150) NOT NULL UNIQUE,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE tipo_notificacion (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre            varchar(150) NOT NULL UNIQUE,
  fundamento_legal  varchar(255),
  dias_surtimiento  smallint,
  descripcion       text,
  active            boolean      NOT NULL DEFAULT true
);

CREATE TABLE medio_notificacion (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(120) NOT NULL UNIQUE,
  active  boolean      NOT NULL DEFAULT true
);

CREATE TABLE estado_proceso (
  id           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre       varchar(80) NOT NULL UNIQUE,
  descripcion  text,
  active       boolean     NOT NULL DEFAULT true
);

CREATE TABLE estado_etapa (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(80) NOT NULL UNIQUE,
  active  boolean     NOT NULL DEFAULT true
);

CREATE TABLE estado_tarea (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(80) NOT NULL UNIQUE,
  active  boolean     NOT NULL DEFAULT true
);

CREATE TABLE prioridad (
  id      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre  varchar(40) NOT NULL UNIQUE,
  nivel   smallint    NOT NULL,
  active  boolean     NOT NULL DEFAULT true
);

-- Puente ternario: combinaciones procesales validas
CREATE TABLE tipo_proc_subtipo_proc_tipo_pre (
  id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tipo_proceso      bigint  NOT NULL REFERENCES tipo_proceso(id)    ON DELETE RESTRICT,
  id_subtipo_proceso   bigint  NOT NULL REFERENCES subtipo_proceso(id) ON DELETE RESTRICT,
  id_tipo_pretension   bigint  NOT NULL REFERENCES tipo_pretension(id) ON DELETE RESTRICT,
  active               boolean NOT NULL DEFAULT true,
  CONSTRAINT uq_combinacion_procesal UNIQUE (id_tipo_proceso, id_subtipo_proceso, id_tipo_pretension)
);

CREATE TABLE etapas_procesales (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tipo_proceso   bigint       NOT NULL REFERENCES tipo_proceso(id) ON DELETE RESTRICT,
  nombre_etapa      varchar(255) NOT NULL,
  descripcion       text,
  fundamento_legal  varchar(255),
  active            boolean      NOT NULL DEFAULT true
);

-- ---------------------------------------------------------------------
-- 2. SEGURIDAD / USUARIOS
-- ---------------------------------------------------------------------

CREATE TABLE users (
  id                          bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre                      varchar(200) NOT NULL,
  email                       varchar(150) NOT NULL UNIQUE,
  password_hash               varchar(255) NOT NULL,
  email_verification_token    varchar(255),
  email_verification_expires  timestamptz,
  v                           integer      NOT NULL DEFAULT 0,   -- __v legacy Mongo
  active                      boolean      NOT NULL DEFAULT true,
  -- Identificacion legal
  tipo_documento              varchar(10)  CHECK (tipo_documento IN ('CC','CE','PA','NIT')),
  numero_documento            varchar(30),
  -- Contacto
  telefono_principal          varchar(40),
  telefono_alterno            varchar(40),
  direccion_notificacion      varchar(255),
  ciudad                      varchar(100),
  departamento                varchar(100),
  pais                        varchar(100) DEFAULT 'Colombia',
  -- Profesional
  tarjeta_profesional         boolean      NOT NULL DEFAULT false,
  numero_tarjeta_prof         varchar(50),
  fecha_expedicion_tp         date,
  especialidades              text[],
  -- Organizacion
  cargo                       varchar(100),
  id_supervisor               bigint       REFERENCES users(id) ON DELETE SET NULL,
  fecha_ingreso               date,
  fecha_retiro                date,
  -- Operacion
  tarifa_hora                 numeric(14,2),
  moneda_tarifa               char(3)      DEFAULT 'COP',
  firma_digital_url           text,
  foto_url                    text,
  zona_horaria                varchar(50)  DEFAULT 'America/Bogota',
  idioma_preferido            varchar(10)  DEFAULT 'es',
  -- Seguridad
  last_login                  timestamptz,
  failed_login_attempts       smallint     NOT NULL DEFAULT 0,
  locked_until                timestamptz,
  mfa_enabled                 boolean      NOT NULL DEFAULT false,
  mfa_secret                  varchar(255),
  password_reset_token        varchar(255),
  password_reset_expires      timestamptz,
  must_change_password        boolean      NOT NULL DEFAULT false,
  created_at                  timestamptz  NOT NULL DEFAULT now(),
  updated_at                  timestamptz  NOT NULL DEFAULT now(),
  CONSTRAINT uq_users_documento UNIQUE (tipo_documento, numero_documento),
  CONSTRAINT ck_users_no_auto_supervisor CHECK (id_supervisor IS DISTINCT FROM id)
);

CREATE TABLE user_rol (
  id          bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_usuario  bigint NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  id_rol      bigint NOT NULL REFERENCES roles(id) ON DELETE RESTRICT,
  CONSTRAINT uq_user_rol UNIQUE (id_usuario, id_rol)
);

-- ---------------------------------------------------------------------
-- 3. PLANTILLAS (motor de generacion automatica)
-- ---------------------------------------------------------------------

CREATE TABLE iter_procesal_plantilla (
  id                                  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tipo_proc_subtipo_proc_tipo_pre  bigint       NOT NULL REFERENCES tipo_proc_subtipo_proc_tipo_pre(id) ON DELETE CASCADE,
  id_etapa                            bigint       NOT NULL REFERENCES etapas_procesales(id) ON DELETE RESTRICT,
  orden                               smallint     NOT NULL,
  id_instancia                        bigint       REFERENCES instancias(id) ON DELETE RESTRICT,
  plazo_dias                          smallint,
  dias_habiles                        char(1)      CHECK (dias_habiles IN ('H','C','M')),  -- Habiles / Calendario / Meses
  dispara_notificacion                boolean      NOT NULL DEFAULT false,
  id_tipo_notificacion_esperada       boolean      NOT NULL DEFAULT false,  -- flag heredado del Excel, no es FK
  nombre_etapa                        varchar(255),
  fundamento_legal                    varchar(255),
  es_obligatoria                      boolean      NOT NULL DEFAULT true,
  observaciones                       text,
  CONSTRAINT uq_iter_orden UNIQUE (id_tipo_proc_subtipo_proc_tipo_pre, orden)
);

CREATE TABLE tareas_plantilla (
  id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_iter_plantilla    bigint       NOT NULL REFERENCES iter_procesal_plantilla(id) ON DELETE CASCADE,
  titulo               varchar(255) NOT NULL,
  descripcion          text,
  dias_desde_etapa     smallint     NOT NULL DEFAULT 0,
  dias_habiles         char(1)      CHECK (dias_habiles IN ('H','C','M')),
  id_prioridad         bigint       REFERENCES prioridad(id) ON DELETE RESTRICT,
  id_rol_responsable   bigint       REFERENCES roles(id)     ON DELETE RESTRICT,
  es_hito_critico      boolean      NOT NULL DEFAULT false,
  active               boolean      NOT NULL DEFAULT true
);

-- ---------------------------------------------------------------------
-- 4. OPERACION POR EXPEDIENTE
-- ---------------------------------------------------------------------

CREATE TABLE expediente (
  id                                  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  numero_de_expediente                varchar(60)  NOT NULL UNIQUE,
  id_usuario                          bigint       NOT NULL REFERENCES users(id) ON DELETE RESTRICT,   -- abogado responsable
  id_cliente                          bigint       REFERENCES clientes(id)        ON DELETE RESTRICT,
  id_calidad_usuario                  bigint       REFERENCES calidad_usuario(id) ON DELETE RESTRICT,
  id_tipo_proc_subtipo_proc_tipo_pre  bigint       NOT NULL REFERENCES tipo_proc_subtipo_proc_tipo_pre(id) ON DELETE RESTRICT,
  id_contraparte                      bigint       REFERENCES contraparte(id)     ON DELETE RESTRICT,
  juzgado_o_autoridad_que_conoce      varchar(255),
  id_estado_proceso                   bigint       REFERENCES estado_proceso(id)  ON DELETE RESTRICT,
  active                              boolean      NOT NULL DEFAULT true,
  created_at                          timestamptz  NOT NULL DEFAULT now(),
  updated_at                          timestamptz  NOT NULL DEFAULT now()
);

CREATE TABLE expediente_etapas (
  id                      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente           bigint      NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_iter_plantilla       bigint      REFERENCES iter_procesal_plantilla(id) ON DELETE SET NULL,  -- NULL = etapa manual
  id_etapa                bigint      REFERENCES etapas_procesales(id) ON DELETE RESTRICT,
  orden                   smallint    NOT NULL,
  id_instancia            bigint      REFERENCES instancias(id)   ON DELETE RESTRICT,
  id_estado_etapa         bigint      NOT NULL REFERENCES estado_etapa(id) ON DELETE RESTRICT,
  fecha_inicio            date,
  fecha_vencimiento       date,
  fecha_fin_real          date,
  id_usuario_responsable  bigint      REFERENCES users(id) ON DELETE SET NULL,
  observaciones           text,
  origen                  varchar(10) NOT NULL DEFAULT 'auto' CHECK (origen IN ('auto','manual')),
  created_at              timestamptz NOT NULL DEFAULT now(),
  updated_at              timestamptz NOT NULL DEFAULT now(),
  active                  boolean     NOT NULL DEFAULT true
);
-- Una etapa de plantilla no se puede clonar dos veces en el mismo expediente.
-- Indice parcial: las etapas manuales (id_iter_plantilla NULL) quedan libres.
CREATE UNIQUE INDEX uq_exp_etapa_plantilla
  ON expediente_etapas (id_expediente, id_iter_plantilla)
  WHERE id_iter_plantilla IS NOT NULL;

CREATE TABLE tareas (
  id                     bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente          bigint       NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_expediente_etapa    bigint       REFERENCES expediente_etapas(id) ON DELETE SET NULL,
  id_tarea_plantilla     bigint       REFERENCES tareas_plantilla(id)  ON DELETE SET NULL,
  titulo                 varchar(255) NOT NULL,
  descripcion            text,
  id_usuario_asignado    bigint       REFERENCES users(id) ON DELETE SET NULL,
  id_usuario_creador     bigint       REFERENCES users(id) ON DELETE SET NULL,
  id_prioridad           bigint       REFERENCES prioridad(id)     ON DELETE RESTRICT,
  id_estado_tarea        bigint       NOT NULL REFERENCES estado_tarea(id) ON DELETE RESTRICT,
  origen                 varchar(10)  NOT NULL DEFAULT 'manual' CHECK (origen IN ('auto','manual')),
  fecha_creacion         timestamptz  NOT NULL DEFAULT now(),
  fecha_limite           date,
  fecha_completado       timestamptz,
  es_hito_preclusivo     boolean      NOT NULL DEFAULT false,
  observaciones          text,
  created_at             timestamptz  NOT NULL DEFAULT now(),
  updated_at             timestamptz  NOT NULL DEFAULT now(),
  active                 boolean      NOT NULL DEFAULT true,
  CONSTRAINT ck_tareas_origen_plantilla
    CHECK ((origen = 'auto' AND id_tarea_plantilla IS NOT NULL) OR origen = 'manual')
);

CREATE TABLE documentos (
  id                    bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente         bigint       NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_tipo_documento     bigint       NOT NULL REFERENCES tipo_documento(id) ON DELETE RESTRICT,
  id_expediente_etapa   bigint       REFERENCES expediente_etapas(id) ON DELETE SET NULL,
  nombre_archivo        varchar(255) NOT NULL,
  titulo                varchar(255),
  descripcion           text,
  url_storage           text         NOT NULL,   -- S3 / storage externo
  mime_type             varchar(120),
  tamano_bytes          bigint,
  fecha_documento       date,
  fecha_carga           timestamptz  NOT NULL DEFAULT now(),
  id_usuario_carga      bigint       REFERENCES users(id) ON DELETE SET NULL,
  version               smallint     NOT NULL DEFAULT 1,
  visibilidad_cliente   boolean      NOT NULL DEFAULT false,
  created_at            timestamptz  NOT NULL DEFAULT now(),
  updated_at            timestamptz  NOT NULL DEFAULT now(),
  active                boolean      NOT NULL DEFAULT true
);

CREATE TABLE actuaciones (
  id                    bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente         bigint       NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_expediente_etapa   bigint       REFERENCES expediente_etapas(id) ON DELETE SET NULL,
  fecha                 date         NOT NULL,
  id_tipo_actuacion     bigint       NOT NULL REFERENCES tipo_actuacion(id) ON DELETE RESTRICT,
  titulo                varchar(255) NOT NULL,
  descripcion           text,
  autoridad_emite       varchar(255),
  id_usuario_registra   bigint       REFERENCES users(id)      ON DELETE SET NULL,
  id_documento          bigint       REFERENCES documentos(id) ON DELETE SET NULL,
  es_hito               boolean      NOT NULL DEFAULT false,
  url_rama_judicial     text,
  created_at            timestamptz  NOT NULL DEFAULT now(),
  updated_at            timestamptz  NOT NULL DEFAULT now(),
  active                boolean      NOT NULL DEFAULT true
);

CREATE TABLE notificaciones (
  id                      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente           bigint      NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_expediente_etapa     bigint      REFERENCES expediente_etapas(id) ON DELETE SET NULL,
  id_actuacion            bigint      REFERENCES actuaciones(id)       ON DELETE SET NULL,
  id_tipo_notificacion    bigint      NOT NULL REFERENCES tipo_notificacion(id)  ON DELETE RESTRICT,
  id_medio_notificacion   bigint      NOT NULL REFERENCES medio_notificacion(id) ON DELETE RESTRICT,
  parte_notificada        varchar(255),
  destinatario            varchar(255),
  direccion_o_correo      varchar(255),
  fecha_realizacion       date,
  fecha_surtimiento       date,
  dias_plazo              smallint,
  fecha_vencimiento       date,          -- = fecha_surtimiento + dias_plazo (calculado en el back)
  objeto_notificacion     text,
  estado                  varchar(30) CHECK (estado IN ('pendiente','enviada','surtida','vencida','fallida')),
  constancia_url          text,
  observaciones           text,
  id_usuario_registra     bigint      REFERENCES users(id) ON DELETE SET NULL,
  created_at              timestamptz NOT NULL DEFAULT now(),
  updated_at              timestamptz NOT NULL DEFAULT now(),
  active                  boolean     NOT NULL DEFAULT true
);

CREATE TABLE audiencias (
  id                      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente           bigint       NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_expediente_etapa     bigint       REFERENCES expediente_etapas(id) ON DELETE SET NULL,
  tipo_audiencia          varchar(150) NOT NULL,
  fecha_programada        timestamptz  NOT NULL,
  modalidad               varchar(20)  CHECK (modalidad IN ('presencial','virtual','mixta')),
  enlace_virtual          text,
  juzgado_o_autoridad     varchar(255),
  direccion_fisica        varchar(255),
  asistentes              text,
  id_usuario_responsable  bigint       REFERENCES users(id)      ON DELETE SET NULL,
  estado                  varchar(30)  CHECK (estado IN ('programada','celebrada','aplazada','cancelada')),
  resultado               text,
  proxima_fecha           timestamptz,
  id_acta_documento       bigint       REFERENCES documentos(id) ON DELETE SET NULL,
  observaciones           text,
  created_at              timestamptz  NOT NULL DEFAULT now(),
  updated_at              timestamptz  NOT NULL DEFAULT now(),
  active                  boolean      NOT NULL DEFAULT true
);

-- ---------------------------------------------------------------------
-- 5. FINANCIERO
-- ---------------------------------------------------------------------

CREATE TABLE honorarios (
  id                       bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente            bigint        NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_usuario               bigint        REFERENCES users(id) ON DELETE SET NULL,
  modalidad                varchar(20)   NOT NULL CHECK (modalidad IN ('fijo','por_etapa','cuota_litis','por_hora','mixto')),
  descripcion_modalidad    text,
  monto_total_pactado      numeric(16,2),
  moneda                   char(3)       NOT NULL DEFAULT 'COP',
  porcentaje_cuota_litis   numeric(5,2)  CHECK (porcentaje_cuota_litis BETWEEN 0 AND 100),
  fecha_pacto              date,
  fecha_inicio             date,
  fecha_fin                date,
  forma_pago               varchar(50),
  numero_cuotas            smallint,
  valor_cuota              numeric(16,2),
  dia_pago_mes             smallint      CHECK (dia_pago_mes BETWEEN 1 AND 31),
  incluye_gastos           boolean       NOT NULL DEFAULT false,
  observaciones            text,
  contrato_url             text,
  estado                   varchar(30)   CHECK (estado IN ('vigente','suspendido','terminado','anulado')),
  active                   boolean       NOT NULL DEFAULT true,
  created_at               timestamptz   NOT NULL DEFAULT now(),
  updated_at               timestamptz   NOT NULL DEFAULT now(),
  CONSTRAINT ck_honorarios_fechas CHECK (fecha_fin IS NULL OR fecha_inicio IS NULL OR fecha_fin >= fecha_inicio)
);

CREATE TABLE pagos (
  id                  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente       bigint       NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_honorario        bigint       REFERENCES honorarios(id) ON DELETE SET NULL,
  id_usuario          bigint       REFERENCES users(id)      ON DELETE SET NULL,
  fecha_pago          date         NOT NULL,
  numero_cuota        smallint,
  concepto            varchar(255),
  monto               numeric(16,2) NOT NULL CHECK (monto > 0),
  moneda              char(3)      NOT NULL DEFAULT 'COP',
  metodo_pago         varchar(50),
  banco               varchar(100),
  numero_referencia   varchar(80),
  numero_factura      varchar(80),
  numero_recibo       varchar(80),
  comprobante_url     text,
  pagado_por          varchar(255),
  observaciones       text,
  estado              varchar(30)  CHECK (estado IN ('pendiente','confirmado','rechazado','anulado')),
  active              boolean      NOT NULL DEFAULT true,
  created_at          timestamptz  NOT NULL DEFAULT now(),
  updated_at          timestamptz  NOT NULL DEFAULT now()
);

CREATE TABLE gastos_proceso (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_expediente     bigint        NOT NULL REFERENCES expediente(id) ON DELETE CASCADE,
  id_usuario        bigint        REFERENCES users(id) ON DELETE SET NULL,
  fecha_gasto       date          NOT NULL,
  categoria_gasto   varchar(80),
  descripcion       text,
  monto             numeric(16,2) NOT NULL CHECK (monto >= 0),
  moneda            char(3)       NOT NULL DEFAULT 'COP',
  proveedor         varchar(255),
  nit_proveedor     varchar(30),
  numero_factura    varchar(80),
  factura_url       text,
  reembolsable      boolean       NOT NULL DEFAULT false,
  reembolsado       boolean       NOT NULL DEFAULT false,
  fecha_reembolso   date,
  pagado_por        varchar(255),
  observaciones     text,
  active            boolean       NOT NULL DEFAULT true,
  created_at        timestamptz   NOT NULL DEFAULT now(),
  updated_at        timestamptz   NOT NULL DEFAULT now(),
  CONSTRAINT ck_gastos_reembolso CHECK (NOT reembolsado OR reembolsable)
);

-- ---------------------------------------------------------------------
-- 6. KANBAN / COLABORACION
-- ---------------------------------------------------------------------

CREATE TABLE tablero_kanban (
  id                      bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre                  varchar(150) NOT NULL,
  descripcion             text,
  tipo_granularidad       varchar(10)  NOT NULL CHECK (tipo_granularidad IN ('tareas','etapas')),
  tipo_ambito             varchar(15)  NOT NULL CHECK (tipo_ambito IN ('personal','expediente','equipo','firma')),
  id_expediente           bigint       REFERENCES expediente(id) ON DELETE CASCADE,
  id_usuario_propietario  bigint       NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  es_publico              boolean      NOT NULL DEFAULT false,
  filtros_default         jsonb,
  vista_default           varchar(15)  DEFAULT 'kanban' CHECK (vista_default IN ('kanban','lista','calendario','timeline')),
  created_at              timestamptz  NOT NULL DEFAULT now(),
  updated_at              timestamptz  NOT NULL DEFAULT now(),
  active                  boolean      NOT NULL DEFAULT true,
  CONSTRAINT ck_tablero_ambito_expediente
    CHECK ((tipo_ambito = 'expediente' AND id_expediente IS NOT NULL)
        OR (tipo_ambito <> 'expediente' AND id_expediente IS NULL))
);

CREATE TABLE columna_kanban (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tablero        bigint       NOT NULL REFERENCES tablero_kanban(id) ON DELETE CASCADE,
  nombre            varchar(80)  NOT NULL,
  orden             smallint     NOT NULL,
  color             char(7)      CHECK (color ~ '^#[0-9A-Fa-f]{6}$'),
  wip_limit         smallint,
  es_inicial        boolean      NOT NULL DEFAULT false,
  es_final          boolean      NOT NULL DEFAULT false,
  regla_auto_mover  jsonb,
  active            boolean      NOT NULL DEFAULT true,
  CONSTRAINT uq_columna_orden UNIQUE (id_tablero, orden)
);
-- Solo UNA columna inicial por tablero
CREATE UNIQUE INDEX uq_columna_inicial ON columna_kanban (id_tablero) WHERE es_inicial;

CREATE TABLE columna_kanban_estado (
  id                bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_columna        bigint NOT NULL REFERENCES columna_kanban(id) ON DELETE CASCADE,
  id_estado_tarea   bigint REFERENCES estado_tarea(id) ON DELETE CASCADE,
  id_estado_etapa   bigint REFERENCES estado_etapa(id) ON DELETE CASCADE,
  CONSTRAINT ck_columna_estado_exclusivo
    CHECK (num_nonnulls(id_estado_tarea, id_estado_etapa) = 1)
);

CREATE TABLE tablero_kanban_usuario (
  id          bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tablero  bigint NOT NULL REFERENCES tablero_kanban(id) ON DELETE CASCADE,
  id_usuario  bigint NOT NULL REFERENCES users(id)          ON DELETE CASCADE,
  CONSTRAINT uq_tablero_usuario UNIQUE (id_tablero, id_usuario)
);

CREATE TABLE tarea_kanban_position (
  id                    bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tablero            bigint        NOT NULL REFERENCES tablero_kanban(id) ON DELETE CASCADE,
  id_columna            bigint        NOT NULL REFERENCES columna_kanban(id) ON DELETE CASCADE,
  tipo_entidad          varchar(10)   NOT NULL CHECK (tipo_entidad IN ('tarea','etapa')),
  id_tarea              bigint        REFERENCES tareas(id)            ON DELETE CASCADE,
  id_expediente_etapa   bigint        REFERENCES expediente_etapas(id) ON DELETE CASCADE,
  orden_vertical        numeric(12,4) NOT NULL,   -- decimal: permite insertar entre 1.0 y 2.0
  fecha_movimiento      timestamptz,
  id_usuario_movio      bigint        REFERENCES users(id) ON DELETE SET NULL,
  created_at            timestamptz   NOT NULL DEFAULT now(),
  updated_at            timestamptz   NOT NULL DEFAULT now(),
  active                boolean       NOT NULL DEFAULT true,
  CONSTRAINT ck_pos_polimorfica CHECK (
    (tipo_entidad = 'tarea' AND id_tarea IS NOT NULL AND id_expediente_etapa IS NULL) OR
    (tipo_entidad = 'etapa' AND id_expediente_etapa IS NOT NULL AND id_tarea IS NULL))
);
-- Una tarea/etapa solo puede aparecer una vez por tablero
CREATE UNIQUE INDEX uq_pos_tarea  ON tarea_kanban_position (id_tablero, id_tarea)            WHERE id_tarea IS NOT NULL;
CREATE UNIQUE INDEX uq_pos_etapa  ON tarea_kanban_position (id_tablero, id_expediente_etapa) WHERE id_expediente_etapa IS NOT NULL;

CREATE TABLE etiqueta (
  id                  bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nombre              varchar(80) NOT NULL UNIQUE,
  color               char(7)     CHECK (color ~ '^#[0-9A-Fa-f]{6}$'),
  icono               varchar(50),
  id_usuario_creador  bigint      REFERENCES users(id) ON DELETE SET NULL,
  descripcion         text,
  created_at          timestamptz NOT NULL DEFAULT now(),
  active              boolean     NOT NULL DEFAULT true
);

CREATE TABLE tarea_etiqueta (
  id                    bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tipo_entidad          varchar(10) NOT NULL CHECK (tipo_entidad IN ('tarea','etapa')),
  id_tarea              bigint      REFERENCES tareas(id)            ON DELETE CASCADE,
  id_expediente_etapa   bigint      REFERENCES expediente_etapas(id) ON DELETE CASCADE,
  id_etiqueta           bigint      NOT NULL REFERENCES etiqueta(id) ON DELETE CASCADE,
  id_usuario_agrego     bigint      REFERENCES users(id) ON DELETE SET NULL,
  created_at            timestamptz NOT NULL DEFAULT now(),
  active                boolean     NOT NULL DEFAULT true,
  CONSTRAINT ck_etiqueta_polimorfica CHECK (
    (tipo_entidad = 'tarea' AND id_tarea IS NOT NULL AND id_expediente_etapa IS NULL) OR
    (tipo_entidad = 'etapa' AND id_expediente_etapa IS NOT NULL AND id_tarea IS NULL))
);

CREATE TABLE comentario_tarea (
  id                     bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tipo_entidad           varchar(10) NOT NULL CHECK (tipo_entidad IN ('tarea','etapa')),
  id_tarea               bigint      REFERENCES tareas(id)            ON DELETE CASCADE,
  id_expediente_etapa    bigint      REFERENCES expediente_etapas(id) ON DELETE CASCADE,
  id_usuario_autor       bigint      NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
  contenido              text        NOT NULL,
  id_comentario_padre    bigint      REFERENCES comentario_tarea(id) ON DELETE CASCADE,
  editado                boolean     NOT NULL DEFAULT false,
  fecha_edicion          timestamptz,
  created_at             timestamptz NOT NULL DEFAULT now(),
  updated_at             timestamptz NOT NULL DEFAULT now(),
  active                 boolean     NOT NULL DEFAULT true,
  CONSTRAINT ck_comentario_polimorfico CHECK (
    (tipo_entidad = 'tarea' AND id_tarea IS NOT NULL AND id_expediente_etapa IS NULL) OR
    (tipo_entidad = 'etapa' AND id_expediente_etapa IS NOT NULL AND id_tarea IS NULL))
);

CREATE TABLE comentario_mencion (
  id             bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_comentario  bigint NOT NULL REFERENCES comentario_tarea(id) ON DELETE CASCADE,
  id_usuario     bigint NOT NULL REFERENCES users(id)            ON DELETE CASCADE,
  CONSTRAINT uq_comentario_mencion UNIQUE (id_comentario, id_usuario)
);

CREATE TABLE checklist_tarea (
  id                    bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tarea              bigint       NOT NULL REFERENCES tareas(id) ON DELETE CASCADE,
  titulo                varchar(255) NOT NULL,
  orden                 smallint     NOT NULL DEFAULT 1,
  completado            boolean      NOT NULL DEFAULT false,
  id_usuario_completo   bigint       REFERENCES users(id) ON DELETE SET NULL,
  fecha_completado      timestamptz,
  id_usuario_asignado   bigint       REFERENCES users(id) ON DELETE SET NULL,
  fecha_limite          date,
  created_at            timestamptz  NOT NULL DEFAULT now(),
  updated_at            timestamptz  NOT NULL DEFAULT now(),
  active                boolean      NOT NULL DEFAULT true
);

CREATE TABLE adjunto_tarea (
  id                     bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tipo_entidad           varchar(12)  NOT NULL CHECK (tipo_entidad IN ('tarea','etapa','comentario')),
  id_tarea               bigint       REFERENCES tareas(id)             ON DELETE CASCADE,
  id_expediente_etapa    bigint       REFERENCES expediente_etapas(id)  ON DELETE CASCADE,
  id_comentario          bigint       REFERENCES comentario_tarea(id)   ON DELETE CASCADE,
  nombre_archivo         varchar(255) NOT NULL,
  url_archivo            text         NOT NULL,
  mime_type              varchar(120),
  tamanio_bytes          bigint,
  id_usuario_subio       bigint       REFERENCES users(id)      ON DELETE SET NULL,
  id_documento_formal    bigint       REFERENCES documentos(id) ON DELETE SET NULL,
  es_privado             boolean      NOT NULL DEFAULT false,
  created_at             timestamptz  NOT NULL DEFAULT now(),
  active                 boolean      NOT NULL DEFAULT true,
  CONSTRAINT ck_adjunto_polimorfico CHECK (
    (tipo_entidad = 'tarea'      AND id_tarea IS NOT NULL            AND id_expediente_etapa IS NULL AND id_comentario IS NULL) OR
    (tipo_entidad = 'etapa'      AND id_expediente_etapa IS NOT NULL AND id_tarea IS NULL            AND id_comentario IS NULL) OR
    (tipo_entidad = 'comentario' AND id_comentario IS NOT NULL       AND id_tarea IS NULL            AND id_expediente_etapa IS NULL))
);

CREATE TABLE tarea_dependencia (
  id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  id_tarea_origen      bigint      REFERENCES tareas(id)            ON DELETE CASCADE,
  id_etapa_origen      bigint      REFERENCES expediente_etapas(id) ON DELETE CASCADE,
  id_tarea_destino     bigint      REFERENCES tareas(id)            ON DELETE CASCADE,
  id_etapa_destino     bigint      REFERENCES expediente_etapas(id) ON DELETE CASCADE,
  tipo_dependencia     char(2)     NOT NULL DEFAULT 'FS' CHECK (tipo_dependencia IN ('FS','SS','FF','SF')),
  dias_lag             smallint    NOT NULL DEFAULT 0,   -- admite negativos (overlap)
  es_bloqueante        boolean     NOT NULL DEFAULT true,
  id_usuario_creador   bigint      REFERENCES users(id) ON DELETE SET NULL,
  observaciones        text,
  created_at           timestamptz NOT NULL DEFAULT now(),
  active               boolean     NOT NULL DEFAULT true,
  CONSTRAINT ck_dep_un_origen  CHECK (num_nonnulls(id_tarea_origen,  id_etapa_origen)  = 1),
  CONSTRAINT ck_dep_un_destino CHECK (num_nonnulls(id_tarea_destino, id_etapa_destino) = 1),
  CONSTRAINT ck_dep_no_autoref CHECK (
    id_tarea_origen IS DISTINCT FROM id_tarea_destino OR
    id_etapa_origen IS DISTINCT FROM id_etapa_destino)
);
-- NOTA: la prevencion de ciclos (DFS al insertar) se implementa en el back.

-- ---------------------------------------------------------------------
-- 7. AUDITORIA
-- ---------------------------------------------------------------------

CREATE TABLE auditoria (
  id             bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tabla          varchar(80) NOT NULL,
  operacion      varchar(10) NOT NULL CHECK (operacion IN ('INSERT','UPDATE','DELETE')),
  id_registro    bigint      NOT NULL,
  id_usuario     bigint      REFERENCES users(id) ON DELETE SET NULL,
  datos_antes    jsonb,
  datos_despues  jsonb,
  created_at     timestamptz NOT NULL DEFAULT now()
);

-- ---------------------------------------------------------------------
-- 8. INDICES
-- ---------------------------------------------------------------------

CREATE INDEX ix_expediente_usuario        ON expediente (id_usuario)        WHERE active;
CREATE INDEX ix_expediente_cliente        ON expediente (id_cliente)        WHERE active;
CREATE INDEX ix_expediente_estado         ON expediente (id_estado_proceso) WHERE active;
CREATE INDEX ix_exp_etapas_expediente     ON expediente_etapas (id_expediente);
CREATE INDEX ix_exp_etapas_estado         ON expediente_etapas (id_estado_etapa);
CREATE INDEX ix_exp_etapas_vencimiento    ON expediente_etapas (fecha_vencimiento) WHERE active;
CREATE INDEX ix_tareas_expediente         ON tareas (id_expediente);
CREATE INDEX ix_tareas_asignado           ON tareas (id_usuario_asignado) WHERE active;
CREATE INDEX ix_tareas_estado             ON tareas (id_estado_tarea);
CREATE INDEX ix_tareas_fecha_limite       ON tareas (fecha_limite) WHERE active;
CREATE INDEX ix_actuaciones_expediente    ON actuaciones (id_expediente);
CREATE INDEX ix_notif_expediente          ON notificaciones (id_expediente);
CREATE INDEX ix_notif_vencimiento         ON notificaciones (fecha_vencimiento) WHERE active;
CREATE INDEX ix_audiencias_fecha          ON audiencias (fecha_programada) WHERE active;
CREATE INDEX ix_documentos_expediente     ON documentos (id_expediente);
CREATE INDEX ix_pagos_expediente          ON pagos (id_expediente);
CREATE INDEX ix_gastos_expediente         ON gastos_proceso (id_expediente);
CREATE INDEX ix_iter_combinacion          ON iter_procesal_plantilla (id_tipo_proc_subtipo_proc_tipo_pre, orden);
CREATE INDEX ix_tareas_plantilla_iter     ON tareas_plantilla (id_iter_plantilla) WHERE active;
CREATE INDEX ix_pos_tablero_columna       ON tarea_kanban_position (id_tablero, id_columna, orden_vertical);
CREATE INDEX ix_comentario_padre          ON comentario_tarea (id_comentario_padre);
CREATE INDEX ix_auditoria_tabla_registro  ON auditoria (tabla, id_registro);

-- ---------------------------------------------------------------------
-- 9. TRIGGER GENERICO updated_at
-- ---------------------------------------------------------------------

CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger AS $$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DO $$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY[
    'users','expediente','expediente_etapas','tareas','documentos','actuaciones',
    'notificaciones','audiencias','honorarios','pagos','gastos_proceso',
    'tablero_kanban','tarea_kanban_position','comentario_tarea','checklist_tarea'
  ] LOOP
    EXECUTE format(
      'CREATE TRIGGER trg_%1$s_updated_at BEFORE UPDATE ON %1$I
       FOR EACH ROW EXECUTE FUNCTION set_updated_at()', t);
  END LOOP;
END $$;

COMMIT;

